{
 "name": "beat_the_game",
 "description": "Defeat the Ender Dragon. Phases run in order; a bot always takes the first unfinished task it is allowed to take.",
 "phases": [
  {"id": "wood", "title": "Gather wood", "tasks": [
   {"id": "logs", "scope": "each", "skill": "gather", "surface": true, "args": {"blocks": "logs", "item": "log", "count": 10}, "skip_if_have": {"pickaxe": 1}}
  ]},
  {"id": "wooden_tools", "title": "Wooden tools", "tasks": [
   {"id": "wooden_pickaxe", "scope": "each", "skill": "craft", "args": {"item": "wooden_pickaxe"}, "have": {"pickaxe": 1}},
   {"id": "wooden_sword", "scope": "each", "skill": "craft", "args": {"item": "wooden_sword"}, "have": {"sword": 1}}
  ]},
  {"id": "stone_tools", "title": "Stone tools", "tasks": [
   {"id": "cobble", "scope": "each", "skill": "gather", "args": {"blocks": "stone", "item": "stone", "count": 12}, "skip_if_have": {"stone_pickaxe|iron_pickaxe": 1}},
   {"id": "stone_pickaxe", "scope": "each", "skill": "craft", "args": {"item": "stone_pickaxe"}, "have": {"stone_pickaxe|iron_pickaxe": 1}},
   {"id": "stone_sword", "scope": "each", "skill": "craft", "args": {"item": "stone_sword"}, "have": {"stone_sword|iron_sword": 1}},
   {"id": "stone_axe", "scope": "each", "skill": "craft", "args": {"item": "stone_axe"}, "have": {"stone_axe|iron_axe": 1}}
  ]},
  {"id": "bed_early", "title": "Bed (when the materials turn up)", "tasks": [
   {"id": "bed", "scope": "each", "skill": "bed", "preempt": true, "needs_fact": "base", "requires": {"bed_material": 1}, "args": {}, "note": "a bed moves the respawn point into the base; worth dropping other work for"}
  ]},
  {"id": "food", "title": "Food", "tasks": [
   {"id": "fish", "scope": "team", "slots": 1, "skill": "fish", "needs_fact": "base", "requires_any": [{"fishing_rod": 1}, {"string": 2}], "team_have": {"food": 8}, "args": {"count": 20}, "note": "endless food from water near the base once someone has string for a rod"},
   {"id": "fish_rod", "scope": "team", "slots": 1, "skill": "fish", "needs_fact": "base", "storage_has": {"string": 2}, "team_have": {"food": 8}, "args": {"count": 20}, "note": "the same, with string from the chest"},
   {"id": "hunt", "scope": "team", "slots": 1, "skill": "hunt", "surface": true, "args": {"count": 64}, "team_have": {"food": 3}, "note": "one hunter feeds the team; the sharing rules hand the meat out"},
   {"id": "cook", "at_base": true, "scope": "each", "skill": "smelt", "needs_fact": "base", "requires": {"raw_meat": 3}, "args": {"input": "raw_meat", "output": "cooked_food", "count": 64}, "repeat": true}
  ]},
  {"id": "base", "title": "Underground base", "tasks": [
   {"id": "dig_base", "scope": "team", "slots": 1, "skill": "build_base", "args": {"depth": 8, "size": 5}, "fact": "base"},
   {"id": "base_exit", "at_base": true, "scope": "team", "slots": 1, "skill": "build_exit", "needs_fact": "base", "preempt": true, "args": {}, "fact": "base_exit", "note": "stairs + door: a way in and out that needs no block placing and keeps mobs out"},
   {"id": "seal_base", "at_base": true, "scope": "team", "slots": 1, "skill": "seal_base", "needs_fact": "base", "while_fact": "base_open", "preempt": true, "requires": {"cobblestone": 8}, "repeat": true, "args": {}, "note": "close holes in the base walls as soon as they are spotted"},
   {"id": "light_base", "at_base": true, "scope": "team", "slots": 1, "skill": "light_base", "needs_fact": "base", "preempt": true, "requires_any": [{"torch": 2}, {"coal": 1}], "args": {}, "fact": "base_lit", "note": "torches stop mobs spawning inside the base"}
  ]},
  {"id": "leather", "title": "Leather armour", "tasks": [
   {"id": "leather_chestplate", "at_base": true, "scope": "each", "skill": "craft_from_storage", "needs_fact": "base", "storage_has": {"leather": 8}, "have": {"leather_chestplate|iron_chestplate": 1}, "args": {"item": "leather_chestplate", "material": "leather", "cost": 8}, "note": "hunting piled leather up in the chest; zombies killed unarmoured bots twelve times in a day"}
  ]},
  {"id": "farm", "title": "Farm room in the base", "tasks": [
   {"id": "farm_room_carrier", "at_base": true, "scope": "team", "slots": 1, "skill": "build_farm_room", "needs_fact": "base", "preempt": true, "requires": {"bucket|water_bucket": 1}, "args": {}, "fact": "farm", "note": "the bot already carrying the bucket and soil finishes the farm before anything else"},
   {"id": "farm_room", "at_base": true, "scope": "team", "slots": 1, "skill": "build_farm_room", "needs_fact": "base", "needs_iron": 3, "args": {}, "fact": "farm", "note": "5x5 room off the base: carried-in soil, corner torches, a bucket of water in the middle, wheat"},
   {"id": "rewater", "at_base": true, "scope": "team", "slots": 1, "skill": "water_farm", "needs_fact": "farm", "while_fact": "farm_dry", "needs_iron": 3, "preempt": true, "repeat": true, "args": {}, "note": "the farm hole lost its water (Baritone filled it to walk across): fetch a bucket of water"},
   {"id": "harvest", "at_base": true, "scope": "team", "slots": 1, "skill": "harvest", "needs_fact": "farm", "preempt": true, "cooldown": 1200, "args": {}, "note": "harvest + replant with Baritone, bake bread"}
  ]},
  {"id": "beds", "title": "Beds", "tasks": [
   {"id": "bed", "scope": "each", "skill": "bed", "surface": true, "needs_fact": "base", "args": {}, "note": "go and find sheep for wool if nobody has a bed yet"}
  ]},
  {"id": "iron", "title": "Iron kit", "tasks": [
   {"id": "craft_kit", "at_base": true, "scope": "each", "skill": "craft", "kit_craft": true, "preempt": true, "args": {}, "note": "crafts the next missing kit item once the bot holds enough iron"},
   {"id": "bow", "scope": "each", "skill": "make_bow", "needs_fact": "base", "storage_has": {"string": 3}, "have": {"bow": 1}, "args": {}, "note": "skeletons and pillagers out-range a sword"},
   {"id": "arrows", "scope": "each", "skill": "make_bow", "requires": {"bow": 1}, "have": {"arrow": 8}, "args": {}},
   {"id": "smelt_trip", "at_base": true, "scope": "each", "skill": "smelt", "preempt": true, "requires": {"raw_iron": 3}, "args": {"input": "raw_iron", "output": "iron_ingot", "count": 64}, "repeat": true},
   {"id": "store", "at_base": true, "scope": "each", "skill": "store", "needs_fact": "base", "repeat": true, "requires_any": [{"iron_ingot": 6}, {"raw_iron": 8}, {"diamond": 1}, {"string": 4}, {"book": 1}, {"ender_pearl": 1}, {"blaze_rod": 1}, {"obsidian": 1}, {"ender_eye": 1}, {"gold_ingot": 1}, {"lapis_lazuli": 1}], "args": {}, "note": "valuables go in the base chest: they survive deaths and anyone can use them"},
   {"id": "smelt_storage", "at_base": true, "scope": "team", "slots": 1, "skill": "smelt_storage", "preempt": true, "storage_has": {"raw_iron": 3}, "repeat": true, "args": {}},
   {"id": "iron_ore", "scope": "team", "slots": 2, "skill": "branch_mine", "kit_mine": true, "trip": 10, "args": {"blocks": "iron", "item": "raw_iron|iron_ingot"}, "note": "two miners dig until the whole team's kit is paid for"},
   {"id": "smelt_iron", "at_base": true, "scope": "each", "skill": "smelt", "requires": {"raw_iron": 1}, "args": {"input": "raw_iron", "output": "iron_ingot", "count": 64}, "repeat": true}
  ]},
  {"id": "ranch", "title": "Animal pen", "tasks": [
   {"id": "build_pen", "scope": "team", "slots": 1, "skill": "build_pen", "surface": true, "needs_fact": "base_exit", "requires": {"cobblestone": 24}, "args": {}, "fact": "pen", "note": "a 4x4 cobblestone-wall pen with a fence gate next to the top of the stairs"},
   {"id": "ranch", "scope": "team", "slots": 1, "skill": "ranch", "surface": true, "needs_fact": "pen", "requires": {"wheat": 2}, "cooldown": 900, "args": {}, "note": "lure cows and sheep in with wheat and breed them; hunters only take the surplus"}
  ]},
  {"id": "diamonds", "title": "Diamonds", "tasks": [
   {"id": "diamonds", "scope": "team", "slots": 1, "skill": "branch_mine", "requires": {"iron_pickaxe": 1}, "team_have": {"diamond": 2}, "args": {"blocks": "diamond", "item": "diamond", "count": 3, "level": -58, "name": "deep_mine", "length": 32, "timeout": 1200}, "note": "a second branch mine at y=-58 under the iron one; also brings back lapis for enchanting"},
   {"id": "diamond_pickaxe", "at_base": true, "scope": "team", "slots": 1, "skill": "craft_from_storage", "storage_has": {"diamond": 3}, "args": {"item": "diamond_pickaxe", "material": "diamond", "cost": 3}, "note": "the only pickaxe that mines obsidian (portal, enchanting table)"}
  ]},
  {"id": "portal", "title": "Obsidian and the nether portal", "tasks": [
   {"id": "obsidian", "scope": "team", "slots": 1, "skill": "obsidian", "requires": {"diamond_pickaxe": 1}, "until_fact": "portal", "team_have": {"obsidian": 4}, "args": {"count": 12}, "note": "water poured on the lava the deep mine ran into, mined with the diamond pickaxe"},
   {"id": "build_portal", "scope": "team", "slots": 1, "skill": "build_portal", "surface": true, "needs_fact": "base_exit", "storage_has": {"obsidian": 10}, "args": {}, "fact": "portal", "note": "obsidian frame by the stairs, lit with flint and steel"}
  ]},
  {"id": "enchanting", "title": "Enchanting", "tasks": [
   {"id": "books", "scope": "team", "slots": 1, "skill": "make_books", "surface": true, "needs_fact": "base", "storage_has": {"leather": 1}, "team_have": {"book": 1}, "args": {"books": 3}, "note": "paper from sugar cane by the water + leather from the chest; one book for the table, the rest towards bookshelves"},
   {"id": "obsidian_table", "scope": "team", "slots": 1, "skill": "obsidian", "needs_fact": "portal", "requires": {"diamond_pickaxe": 1}, "until_fact": "enchanting_table", "team_have": {"obsidian": 2}, "args": {"count": 4}},
   {"id": "enchanting_table", "at_base": true, "scope": "team", "slots": 1, "skill": "enchanting_table", "needs_fact": "base", "storage_has": {"diamond": 2, "book": 1}, "args": {}, "fact": "enchanting_table", "note": "a book, two diamonds and four obsidian; in the base room's corner"},
   {"id": "enchant", "at_base": true, "scope": "each", "skill": "enchant", "needs_fact": "enchanting_table", "storage_has": {"lapis_lazuli": 1}, "cooldown": 1800, "args": {}, "note": "sword, pickaxe, chestplate, bow - whatever the levels and lapis allow"}
  ]},
  {"id": "nether", "title": "The nether: blaze rods", "tasks": [
   {"id": "smelt_gold_chest", "at_base": true, "scope": "team", "slots": 1, "skill": "smelt_storage", "storage_has": {"raw_gold": 3}, "repeat": true, "args": {"raw": "raw_gold", "out": "gold_ingot"}},
   {"id": "smelt_gold", "at_base": true, "scope": "each", "skill": "smelt", "requires": {"raw_gold": 1}, "args": {"input": "raw_gold", "output": "gold_ingot", "count": 64}, "repeat": true},
   {"id": "gold_helmet", "scope": "each", "skill": "craft", "needs_fact": "portal", "requires": {"gold_ingot": 5}, "have": {"golden_helmet": 1}, "args": {"item": "golden_helmet"}, "note": "piglins leave players in gold alone"},
   {"id": "gold_helmet_chest", "at_base": true, "scope": "each", "skill": "craft_from_storage", "needs_fact": "portal", "storage_has": {"gold_ingot": 5}, "have": {"golden_helmet": 1}, "args": {"item": "golden_helmet", "material": "gold_ingot", "cost": 5}},
   {"id": "blaze_rods", "scope": "team", "slots": 2, "skill": "blaze_rods", "needs_fact": "portal", "requires": {"iron_sword": 1}, "team_have": {"blaze_rod|ender_eye": 3}, "args": {"count": 6}, "note": "Baritone's cache finds a fortress's blaze spawner; two bots fight there together"}
  ]},
  {"id": "pearls", "title": "Ender pearls and eyes of ender", "tasks": [
   {"id": "pearls", "scope": "team", "slots": 2, "skill": "hunt", "surface": true, "night": true, "needs_fact": "portal", "requires": {"iron_sword": 1}, "team_have": {"ender_pearl|ender_eye": 6}, "args": {"animals": "enderman", "item": "ender_pearl", "count": 16, "timeout": 1200}, "note": "endermen at night: the one job allowed out after dark"},
   {"id": "eyes", "at_base": true, "scope": "team", "slots": 1, "skill": "make_eyes", "storage_has": {"ender_pearl": 1, "blaze_rod": 1}, "cooldown": 300, "args": {"count": 18}}
  ]},
  {"id": "stronghold", "title": "Stronghold and the end portal", "tasks": [
   {"id": "find_stronghold", "scope": "team", "slots": 1, "skill": "find_stronghold", "surface": true, "needs_fact": "base_exit", "storage_has": {"ender_eye": 2}, "args": {}, "fact": "stronghold", "note": "two eye throws 200 blocks apart; the lines cross over the stronghold"},
   {"id": "open_end_portal", "scope": "team", "slots": 1, "skill": "open_end_portal", "needs_fact": "stronghold", "storage_has": {"ender_eye": 10}, "args": {}, "fact": "end_portal", "note": "walk there, dig down, find the portal room (Baritone caches portal frames), fill the frame"}
  ]},
  {"id": "dragon", "title": "The dragon", "tasks": [
   {"id": "end_arrows", "scope": "each", "skill": "make_bow", "needs_fact": "end_portal", "have": {"arrow": 48}, "args": {"arrows": 64}},
   {"id": "end_blocks", "scope": "each", "skill": "gather", "needs_fact": "end_portal", "args": {"blocks": "stone", "item": "cobblestone", "count": 48}, "note": "for bridging to the island and towering"},
   {"id": "dragon", "scope": "each", "skill": "end_fight", "needs_fact": "end_portal", "requires": {"bow": 1, "arrow": 16}, "until_fact": "dragon_dead", "args": {}, "note": "crystals first with arrows, then the dragon: arrows in flight, the sword when it perches"}
  ]}
 ],
 "kit": {"material": "iron_ingot", "raw": "raw_iron", "items": [["iron_pickaxe", 3], ["shears", 2], ["shield", 1], ["iron_sword", 2], ["iron_chestplate", 8], ["iron_helmet", 5], ["iron_boots", 4], ["iron_leggings", 7]]},
 "sharing": [
  {"item": "food", "low": 1, "keep": 2, "give": 2, "max_food": 12, "note": "only to teammates who are actually hungry"},
  {"item": "bed", "need_spec": "bed_material", "low": 1, "keep": 0, "give": 1, "min_give": 1, "giver_done": "bed", "to_not_done": "bed", "note": "a spare bed goes to whoever has none"},
  {"item": "wool", "need_spec": "bed_material", "low": 1, "keep": 0, "give": 3, "min_give": 1, "giver_done": "bed", "to_not_done": "bed", "note": "spare wool goes to whoever still needs a bed"}
 ],
 "fallback": {"id": "stockpile_wood", "skill": "gather", "surface": true, "args": {"blocks": "logs", "item": "log", "count": 32}}
}

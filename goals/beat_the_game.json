{
 "name": "beat_the_game",
 "description": "Defeat the Ender Dragon. Phases run in order; a bot always takes the first unfinished task it is allowed to take.",
 "phases": [
  {"id": "wood", "title": "Gather wood", "tasks": [
   {"id": "logs", "scope": "each", "skill": "gather", "surface": true, "args": {"blocks": "logs", "item": "log", "count": 10}, "skip_if_have": {"pickaxe": 1}}
  ]},
  {"id": "wooden_tools", "title": "Wooden tools", "tasks": [
   {"id": "wooden_pickaxe", "scope": "each", "skill": "craft", "args": {"item": "wooden_pickaxe"}, "have": {"pickaxe": 1}},
   {"id": "wooden_sword", "scope": "each", "skill": "craft", "args": {"item": "wooden_sword"}, "have": {"sword": 1}}
  ]},
  {"id": "stone_tools", "title": "Stone tools", "tasks": [
   {"id": "cobble", "scope": "each", "skill": "gather", "args": {"blocks": "stone", "item": "stone", "count": 12}, "skip_if_have": {"stone_pickaxe|iron_pickaxe": 1}},
   {"id": "stone_pickaxe", "scope": "each", "skill": "craft", "args": {"item": "stone_pickaxe"}, "have": {"stone_pickaxe|iron_pickaxe": 1}},
   {"id": "stone_sword", "scope": "each", "skill": "craft", "args": {"item": "stone_sword"}, "have": {"stone_sword|iron_sword": 1}},
   {"id": "stone_axe", "scope": "each", "skill": "craft", "args": {"item": "stone_axe"}, "have": {"stone_axe|iron_axe": 1}}
  ]},
  {"id": "bed_early", "title": "Bed (when the materials turn up)", "tasks": [
   {"id": "bed", "scope": "each", "skill": "bed", "preempt": true, "needs_fact": "base", "requires": {"bed_material": 1}, "args": {}, "note": "a bed moves the respawn point into the base; worth dropping other work for"}
  ]},
  {"id": "food", "title": "Food", "tasks": [
   {"id": "fish", "scope": "team", "slots": 1, "skill": "fish", "needs_fact": "base", "requires_any": [{"fishing_rod": 1}, {"string": 2}], "team_have": {"food": 8}, "args": {"count": 20}, "note": "endless food from water near the base once someone has string for a rod"},
   {"id": "hunt", "scope": "team", "slots": 1, "skill": "hunt", "surface": true, "args": {"count": 64}, "team_have": {"food": 3}, "note": "one hunter feeds the team; the sharing rules hand the meat out"},
   {"id": "cook", "at_base": true, "scope": "each", "skill": "smelt", "needs_fact": "base", "requires": {"raw_meat": 3}, "args": {"input": "raw_meat", "output": "cooked_food", "count": 64}, "repeat": true}
  ]},
  {"id": "base", "title": "Underground base", "tasks": [
   {"id": "dig_base", "scope": "team", "slots": 1, "skill": "build_base", "args": {"depth": 8, "size": 5}, "fact": "base"},
   {"id": "base_exit", "at_base": true, "scope": "team", "slots": 1, "skill": "build_exit", "needs_fact": "base", "preempt": true, "args": {}, "fact": "base_exit", "note": "stairs + door: a way in and out that needs no block placing and keeps mobs out"},
   {"id": "seal_base", "at_base": true, "scope": "team", "slots": 1, "skill": "seal_base", "needs_fact": "base", "while_fact": "base_open", "preempt": true, "requires": {"cobblestone": 8}, "repeat": true, "args": {}, "note": "close holes in the base walls as soon as they are spotted"},
   {"id": "light_base", "at_base": true, "scope": "team", "slots": 1, "skill": "light_base", "needs_fact": "base", "preempt": true, "requires_any": [{"torch": 2}, {"coal": 1}], "args": {}, "fact": "base_lit", "note": "torches stop mobs spawning inside the base"}
  ]},
  {"id": "farm", "title": "Farm room in the base", "tasks": [
   {"id": "farm_room_carrier", "at_base": true, "scope": "team", "slots": 1, "skill": "build_farm_room", "needs_fact": "base", "preempt": true, "requires": {"bucket|water_bucket": 1}, "args": {}, "fact": "farm", "note": "the bot already carrying the bucket and soil finishes the farm before anything else"},
   {"id": "farm_room", "at_base": true, "scope": "team", "slots": 1, "skill": "build_farm_room", "needs_fact": "base", "needs_iron": 3, "args": {}, "fact": "farm", "note": "5x5 room off the base: carried-in soil, corner torches, a bucket of water in the middle, wheat"},
   {"id": "rewater", "at_base": true, "scope": "team", "slots": 1, "skill": "water_farm", "needs_fact": "farm", "while_fact": "farm_dry", "needs_iron": 3, "preempt": true, "repeat": true, "args": {}, "note": "the farm hole lost its water (Baritone filled it to walk across): fetch a bucket of water"},
   {"id": "harvest", "at_base": true, "scope": "team", "slots": 1, "skill": "harvest", "needs_fact": "farm", "cooldown": 1200, "args": {}, "note": "harvest + replant with Baritone, bake bread"}
  ]},
  {"id": "beds", "title": "Beds", "tasks": [
   {"id": "bed", "scope": "each", "skill": "bed", "surface": true, "needs_fact": "base", "args": {}, "note": "go and find sheep for wool if nobody has a bed yet"}
  ]},
  {"id": "iron", "title": "Iron kit", "tasks": [
   {"id": "craft_kit", "at_base": true, "scope": "each", "skill": "craft", "kit_craft": true, "preempt": true, "args": {}, "note": "crafts the next missing kit item once the bot holds enough iron"},
   {"id": "smelt_trip", "at_base": true, "scope": "each", "skill": "smelt", "requires": {"raw_iron": 8}, "args": {"input": "raw_iron", "output": "iron_ingot", "count": 64}, "repeat": true},
   {"id": "store", "at_base": true, "scope": "each", "skill": "store", "needs_fact": "base", "repeat": true, "requires_any": [{"iron_ingot": 6}, {"raw_iron": 8}, {"diamond": 1}, {"string": 4}], "args": {}, "note": "valuables go in the base chest: they survive deaths and anyone can use them"},
   {"id": "smelt_storage", "at_base": true, "scope": "team", "slots": 1, "skill": "smelt_storage", "storage_has": {"raw_iron": 3}, "repeat": true, "args": {}},
   {"id": "iron_ore", "scope": "team", "slots": 2, "skill": "gather", "kit_mine": true, "trip": 10, "args": {"blocks": "iron", "item": "raw_iron|iron_ingot"}, "note": "two miners dig until the whole team's kit is paid for"},
   {"id": "smelt_iron", "at_base": true, "scope": "each", "skill": "smelt", "requires": {"raw_iron": 1}, "args": {"input": "raw_iron", "output": "iron_ingot", "count": 64}, "repeat": true}
  ]},
  {"id": "todo", "title": "Not implemented yet", "tasks": [
   {"id": "next", "scope": "team", "slots": 0, "skill": "idle", "args": {}, "note": "diamonds -> enchanting (table, bookshelves, lapis, xp) -> obsidian/nether portal -> blaze rods -> ender pearls -> stronghold -> dragon"}
  ]}
 ],
 "kit": {"material": "iron_ingot", "raw": "raw_iron", "items": [["iron_pickaxe", 3], ["shears", 2], ["shield", 1], ["iron_sword", 2], ["iron_chestplate", 8], ["iron_helmet", 5], ["iron_boots", 4], ["iron_leggings", 7]]},
 "sharing": [
  {"item": "food", "low": 1, "keep": 2, "give": 2, "max_food": 12, "note": "only to teammates who are actually hungry"},
  {"item": "bed", "need_spec": "bed_material", "low": 1, "keep": 0, "give": 1, "min_give": 1, "giver_done": "bed", "to_not_done": "bed", "note": "a spare bed goes to whoever has none"},
  {"item": "wool", "need_spec": "bed_material", "low": 1, "keep": 0, "give": 3, "min_give": 1, "giver_done": "bed", "to_not_done": "bed", "note": "spare wool goes to whoever still needs a bed"}
 ],
 "fallback": {"id": "stockpile_wood", "skill": "gather", "surface": true, "args": {"blocks": "logs", "item": "log", "count": 32}}
}
